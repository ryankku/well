{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/checkout.html", "dest": "/checkout.html" },
    { "src": "/checkout-status", "dest": "/checkout-status.html" },
    { "src": "/checkout-status.html", "dest": "/checkout-status.html" },
    { "src": "/product", "dest": "/product.html" },
    { "src": "/product.html", "dest": "/product.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
