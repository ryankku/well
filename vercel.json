{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/admin", "dest": "/client/admin/dashboard.html" },
    { "src": "/admin/(.*)", "dest": "/client/admin/$1" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
